+class _TestCapture:
+    def __init__(self, path):
+        with open(path, "rb") as stream:
+            self.pcm = stream.read()
+        self.sent, self.start = 0, time.monotonic()
+
+    def read(self, frames):
+        size = frames * 2
+        chunk = self.pcm[self.sent:self.sent + size]
+        chunk += bytes(size - len(chunk))
+        self.sent += size
+        delay = self.start + self.sent / 32000 - time.monotonic()
+        if delay > 0:
+            time.sleep(delay)
+        return chunk
+
+    def close(self):
+        pass
+
